{
  "name": "eyesoul",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:setup": "npm run db:setup -w @eyesoul/api",
    "dev:api": "npm run dev -w @eyesoul/api",
    "dev:web": "npm run dev -w @eyesoul/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "api:build": "docker compose --profile api build api",
    "db:deploy": "npm run db:deploy -w @eyesoul/api",
    "api:up": "docker compose --profile api up --build api"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "msw": false
  }
}
