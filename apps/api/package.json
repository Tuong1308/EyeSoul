{
  "name": "@eyesoul/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:setup": "npm run db:deploy && prisma db seed",
    "db:deploy": "prisma migrate deploy"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@prisma/client": "^6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eyesoul/shared": "*",
    "@nestjs/cli": "^11",
    "@nestjs/testing": "^11",
    "@types/express": "^5",
    "@types/jest": "^29",
    "@types/node": "^22",
    "@types/supertest": "^6",
    "dotenv": "^16",
    "jest": "^29",
    "prisma": "^6",
    "supertest": "^7",
    "ts-jest": "^29",
    "tsx": "^4",
    "typescript": "~5.8"
  }
}
